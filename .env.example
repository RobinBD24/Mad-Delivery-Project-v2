# ─────────────────────────────────────────────────────────────
# MAD Delivery HQ — Next.js-only full-stack app
# Copy to .env.local (Next.js runtime) AND .env (Prisma CLI) for local dev:
#   cp .env.example .env.local && cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────

# Database — SQLite for local dev (zero setup).
# For PostgreSQL: set provider = "postgresql" in prisma/schema.prisma and use:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mad_delivery?schema=public"
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth secret — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="dev-only-change-me-please-generate-a-real-secret"

# Auth.js derives the current app origin from Host/X-Forwarded-* request headers.
# Keep AUTH_URL and NEXTAUTH_URL unset so login/logout work on every deployment
# URL. The reverse proxy must forward Host, X-Forwarded-Host and
# X-Forwarded-Proto.
AUTH_TRUST_HOST=true

# ── FILE UPLOADS ─────────────────────────────────────────────────────────
# Runtime upload directory (relative to the app cwd, or an absolute path).
# Files are stored HERE, not in public/, and served via the /api/uploads route
# — so uploads work in `next start` and survive restarts. In production point
# this at a PERSISTENT, WRITABLE disk (e.g. UPLOAD_DIR=/var/lib/mad/uploads).
UPLOAD_DIR=storage/uploads

# Optional: if set, uploaded-file URLs are built as
#   ${NEXT_PUBLIC_UPLOAD_BASE_URL}/<key>  (e.g. an S3/R2/CDN base).
# Leave empty to serve through the internal /api/uploads route.
NEXT_PUBLIC_UPLOAD_BASE_URL=

# Default Super Admin created by `npm run seed`.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@maddelivery.com
ADMIN_PASSWORD=Admin12345@##

# ── OPTIONAL — EXTERNAL INTEGRATIONS ─────────────────────────
# Every feature below has a working local/demo fallback; set a key to go live.
# The app runs fully without any of these.

# Google Maps — live rider pin + branch delivery-zone map.
# Without it: polished map placeholder + raw coordinates are shown.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OTP / SMS login (customer). Without it: username/password login is primary.
# SMS_PROVIDER=            # e.g. twilio | ssl_wireless | bulksmsbd
# SMS_API_KEY=
# SMS_SENDER_ID=

# Web push notifications. Without it: in-app DB notifications + bell fully work.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@maddelivery.com

# Payment gateway (bKash / card). Without it: cash + record-only bKash work.
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_BASE_URL=

# Server-side PDF/Excel export. Without it: CSV export + browser print-to-PDF work.
# (No key needed for CSV; a PDF/XLSX lib or service is the only external piece.)

# File uploads — every uploaded image is auto-converted to WebP (sharp) and
# written to the runtime UPLOAD_DIR (see FILE UPLOADS above), served same-origin
# via /api/uploads. Allowed input: image/jpeg, image/png, image/webp, image/avif
# (max 5MB); final stored format is always .webp. For cloud storage (S3/R2),
# wire a provider in lib/http/upload.ts and set NEXT_PUBLIC_UPLOAD_BASE_URL +
# the credentials here.
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
